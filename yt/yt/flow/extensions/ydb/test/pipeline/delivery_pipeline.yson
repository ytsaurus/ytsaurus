    "dynamic_spec" = {
        "computations" = {
            "alo_generator" = {
                "input_rows_throttler_id" = "alo_generator_rows";
                "max_rows_per_batch" = 10;
                "source_streams" = {"random" = {"parameters" = {
                    "partition_count" = 1;
                    "message_count_mean" = 10;
                    "message_key_range" = 1024;
                    "message_size_mean" = 128;
                };};};
            };
            "alo_second_generator" = {
