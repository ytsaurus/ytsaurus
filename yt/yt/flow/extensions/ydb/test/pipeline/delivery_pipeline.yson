{
    "spec" = {
        "resources" = {
            "YdbDriver" = {
                "resource_class_name" = "NYT::NFlow::TYdbTopicDriver";
                "parameters" = {"auth_mode" = "anonymous";};
                "dependencies" = {};
            };
        };
        "computations" = {
            "alo_generator" = {
                "computation_class_name" = "NYT::NFlow::TProcessFunctionTransformOrderedSourceComputation";
                "processing_function" = "NYT::NFlow::NYdbTest::TDeliveryProbeGenerator";
                "processing_function_parameters" = {
                    "run_id" = "ydb-delivery-validation-v1";
                    "lane" = "alo";
                    "window_size" = 60000;
                    "generated_stream_id" = "alo_generated";
                    "expected_stream_id" = "alo_expected";
                };
                "output_stream_ids" = ["alo_generated"; "alo_expected"];
                "required_resource_ids" = {
                    "YdbDriver" = {"controller" = %true; "worker" = %true;};
                };
                "source_streams" = {
                    "random" = {
                        "source_class_name" = "NYT::NFlow::TRandomSource";
                        "parameters" = {"finite" = %false;};
                    };
                };
                "sinks" = {
                    "output" = {
                        "sink_class_name" = "NYT::NFlow::TYdbSink";
                        "input_stream_ids" = ["alo_generated"];
                        "parameters" = {
                            "endpoint" = "localhost:2135";
                            "database" = "/Root/db";
                            "topic" = "delivery/output";
                            "codec" = "raw";
                            "write_flow_queue_meta" = %true;
                        };
                    };
                };
                "streams_dependency" = {
                    "alo_generated" = ["random"];
                    "alo_expected" = ["random"];
                };
                "parameters" = {};
            };
            "alo_observer" = {
                "computation_class_name" = "NYT::NFlow::TProcessFunctionSourceComputation";
                "processing_function" = "NYT::NFlow::NYdbTest::TDeliveryProbeOutputReader";
                "processing_function_parameters" = {
                    "run_id" = "ydb-delivery-validation-v1"; "lane" = "alo";
                    "observed_stream_id" = "alo_observed";
                };
                "output_stream_ids" = ["alo_observed"];
                "required_resource_ids" = {"YdbDriver" = {"controller" = %true; "worker" = %true;};};
                "source_streams" = {"alo_output" = {"source_class_name" = "NYT::NFlow::TYdbSource"; "parameters" = {
                    "endpoint" = "localhost:2135"; "database" = "/Root/db"; "topic" = "delivery/output";
                    "consumer" = "delivery/consumer"; "finite" = %false; "try_parse_flow_queue_meta" = %true;
                };};};
                "streams_dependency" = {"alo_observed" = ["alo_output"];};
                "watermark_strategy" = {"watermark_generator" = {
                    "use_source_watermark" = %true;
                    "unavailable_partition_groups" = {"max_unavailable_groups" = 0; "min_available_groups" = 1;};
                };};
                "parameters" = {};
            };
            "alo_validator" = {
                "computation_class_name" = "NYT::NFlow::TProcessFunctionComputation";
                "processing_function" = "NYT::NFlow::NYdbTest::TDeliveryProbeValidator";
                "processing_function_parameters" = {
                    "run_id" = "ydb-delivery-validation-v1"; "lane" = "alo";
                    "exactly_once" = %false; "window_size" = 60000;
                    "expected_stream_id" = "alo_expected"; "observed_stream_id" = "alo_observed";
                    "close_timer_stream_id" = "alo_close"; "status_timer_stream_id" = "alo_status";
                };
                "input_stream_ids" = ["alo_expected"; "alo_observed"];
                "group_by_schema" = [
                    {"name" = "hash"; "expression" = "farm_hash(run_id, lane)"; "type" = "uint64"; "required" = %true;};
                    {"name" = "run_id"; "type" = "string";}; {"name" = "lane"; "type" = "string";};
                ];
                "allow_timer_self_dependency" = %true;
                "timer_streams" = {
                    "alo_close" = {"time_type" = "event_time";};
                    "alo_status" = {"time_type" = "current_time";};
                };
                "streams_dependency" = {
                    "alo_close" = ["alo_expected"; "alo_observed"];
                    "alo_status" = ["alo_expected"; "alo_observed"; "alo_close"; "alo_status"];
                };
                "parameters" = {};
            };
            "alo_second_generator" = {
                "computation_class_name" = "NYT::NFlow::TProcessFunctionTransformOrderedSourceComputation";
