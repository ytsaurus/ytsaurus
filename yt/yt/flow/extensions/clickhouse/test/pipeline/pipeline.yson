{
    "spec" = {
        "computations" = {
            "reader" = {
                "computation_class_name" = "TTypedReader";
                "output_stream_ids" = ["rows"];
                "source_streams" = {
                    "random" = {
                        "source_class_name" = "NYT::NFlow::TRandomSource";
                        "parameters" = {
                            "finite" = %true;
                        };
                    };
                };
                "sinks" = {
                    "clickhouse" = {
                        "sink_class_name" = "NYT::NFlow::TClickHouseBatchingSink";
                        "input_stream_ids" = ["rows"];
                        "parameters" = {};
                    };
                };
                "parameters" = {};
            };
        };
        "streams" = {
            "rows" = {
                "schema" = [
                    {name = "id"; type = "string"; required = %true;};
                    {name = "seq"; type = "int64"; required = %true;};
                    {name = "flag"; type = "boolean"; required = %true;};
                    {name = "category"; type = "string"; required = %true;};
                    {name = "code"; type = "string"; required = %true;};
                    {name = "note"; type = "string"; required = %false;};
                    {name = "advertiser_tokens"; type_v3 = {type_name = "list"; item = "string";};};
                    {name = "clicks"; type = "uint64"; required = %true;};
                    {name = "impressions"; type = "uint64"; required = %true;};
                    {name = "cost"; type = "uint64"; required = %true;};
                    {name = "bid"; type = "uint64"; required = %true;};
                    {name = "impressions_in_top"; type = "uint64"; required = %true;};
                ];
            };
        };
    };
    "dynamic_spec" = {
        "computations" = {
            "reader" = {
                "parameters" = {};
                "source_streams" = {
                    "random" = {
                        "parameters" = {
                            "partition_count" = 4;
                            "partition_message_count" = 50;
                        };
                    };
                };
            };
        };
    };
}
