{
    "spec" = {
        "computations" = {
            "source_reader" = {
                "computation_class_name" = "NYT::NFlow::TSwiftPassthroughOrderedSourceComputation";
                "output_stream_ids" = ["source_records"];
                "source_streams" = {
                    "queue_source" = {
                        "source_class_name" = "NYT::NFlow::TQueueSource";
                        "parameters" = {};
                    };
                };
            };
            "audit_reader" = {
                "computation_class_name" = "NYT::NFlow::TSwiftPassthroughOrderedSourceComputation";
                "output_stream_ids" = ["audit_records"];
                "source_streams" = {
                    "queue_source" = {
                        "source_class_name" = "NYT::NFlow::TQueueSource";
                        "parameters" = {};
                    };
                };
            };
            "reference_writer" = {
                "computation_class_name" = "NYT::NFlow::TProcessFunctionComputation";
                "processing_function" = "NYT::NFlow::NUIScreenshotPipeline::TReferenceWriterFunction";
                "group_by_schema" = [
                    {"name" = "hash"; "expression" = "farm_hash(key)"; "type" = "uint64"; required = %true;};
                    {"name" = "key"; "type" = "string";};
                ];
                "input_stream_ids" = ["source_records"];
                "output_stream_ids" = [];
                "external_state_managers" = {
                    "/reference_state" = {
                        "external_state_manager_class_name" = "NYT::NFlow::TSimpleExternalStateManager";
                        "parameters" = {};
                    };
                };
                "key_visitor_streams" = {
                    "state_visit" = {
                        "names" = ["/state"];
                    };
                    "reference_state_visit" = {
                        "external_names" = ["/reference_state"];
                    };
                };
            };
            "keyed_transform" = {
                "computation_class_name" = "NYT::NFlow::NUIScreenshotPipeline::TSlowPassthroughComputation";
                "group_by_schema" = [
                    {"name" = "hash"; "expression" = "farm_hash(key)"; "type" = "uint64"; required = %true;};
                    {"name" = "key"; "type" = "string";};
                ];
                "input_stream_ids" = ["source_records"];
                "output_stream_ids" = ["transformed_records"];
                "parameters" = {
                    "processing_delay" = 10;
                };
            };
            "queue_writer" = {
                "computation_class_name" = "NYT::NFlow::TPassthroughComputation";
                "group_by_schema" = [
                    {"name" = "hash"; "expression" = "farm_hash(key)"; "type" = "uint64"; required = %true;};
                    {"name" = "key"; "type" = "string";};
                ];
                "input_stream_ids" = ["transformed_records"];
                "output_stream_ids" = ["output_records"];
                "sinks" = {
                    "output_sink" = {
                        "sink_class_name" = "NYT::NFlow::TAsyncQueueSink";
                        "input_stream_ids" = ["output_records"];
                        "parameters" = {};
                    };
                    "audit_sink" = {
                        "sink_class_name" = "NYT::NFlow::TAsyncQueueSink";
                        "input_stream_ids" = ["output_records"];
                        "parameters" = {};
                    };
                };
            };
        };
        "streams" = {
            "source_records" = {
                "schema" = [
                    {"name" = "key"; "type" = "string"; required = %true;};
                    {"name" = "value"; "type" = "string"; required = %true;};
                ];
            };
            "transformed_records" = {
                "schema" = [
                    {"name" = "key"; "type" = "string"; required = %true;};
                    {"name" = "value"; "type" = "string"; required = %true;};
                ];
            };
            "output_records" = {
                "schema" = [
                    {"name" = "key"; "type" = "string"; required = %true;};
                    {"name" = "value"; "type" = "string"; required = %true;};
                ];
            };
            "audit_records" = {
                "schema" = [
                    {"name" = "key"; "type" = "string"; required = %true;};
                    {"name" = "value"; "type" = "string"; required = %true;};
                ];
            };
        };
    };
    "dynamic_spec" = {
        "computations" = {
            "source_reader" = {
                "batch_duration" = 250;
                "max_rows_per_batch" = 50;
                "source_streams" = {
                    "queue_source" = {
                        "parameters" = {};
                    };
                };
            };
            "audit_reader" = {
                "batch_duration" = 250;
                "max_rows_per_batch" = 50;
                "source_streams" = {
                    "queue_source" = {
                        "parameters" = {};
                    };
                };
            };
            "reference_writer" = {
                "batch_duration" = 250;
                "max_rows_per_batch" = 50;
                "key_visitor_streams" = {
                    "state_visit" = {
                        "period" = "2s";
                    };
                    "reference_state_visit" = {
                        "period" = "2s";
                    };
                };
                "parameters" = {
                    "desired_partition_count" = 3;
                };
            };
            "keyed_transform" = {
                "batch_duration" = 250;
                "max_rows_per_batch" = 50;
                "parameters" = {
                    "desired_partition_count" = 3;
                };
            };
            "queue_writer" = {
                "batch_duration" = 250;
                "max_rows_per_batch" = 50;
                "parameters" = {
                    "desired_partition_count" = 3;
                };
            };
        };
        "job_manager" = {
            "use_cpu_aware_balancer" = %false;
        };
        "job_tracker" = {
            "job_threads" = 4;
        };
    };
}
