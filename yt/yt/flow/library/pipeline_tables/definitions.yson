                "dynamic" = %true;
            };
        };
    };
    "queues" = {
        "timer_page_journal" = {
            "schema" = <"strict"=%true;"unique_keys"=%false;>[
                {"name"="computation_id";"type"="string";};
                {"name"="family_id";"type"="uint64";};
                {"name"="begin_timestamp";"type"="uint64";};
                {"name"="op";"type"="string";};
                {"name"="stream_id";"type"="string";};
                {"name"="kind";"type"="string";};
                {"name"="key_begin";"type"="string";};
                {"name"="key_end";"type"="string";};
                {"name"="once_shared";"type"="boolean";};
                {"name"="event_done";"type"="boolean";};
                {"name"="dedup_slots";"type"="boolean";};
                {"name"="$timestamp";"type"="uint64";};
                {"name"="$cumulative_data_weight";"type"="int64";};
            ];
            "attributes" = {
                "dynamic" = %true;
                "tablet_count" = 1;
                "mount_config" = {
                    "min_data_versions" = 0;
                    "min_data_ttl" = 0;
                    "max_data_ttl" = 86400000;
                };
            };
        };
        "controller_logs" = {
