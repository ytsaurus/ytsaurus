        "partition_transactions" = {
            "schema" = <"strict"=%true;"unique_keys"=%true;>[
                {
                    "name" = "hash";
                    "expression" = "farm_hash(partition_id)";
                    "type" = "uint64";
                    "sort_order" = "ascending";
                    "group" = "default";
                };
                {"name"="partition_id";"type"="string";"sort_order"="ascending";"group"="default";};
                {"name"="last_transaction_start_timestamp";"type"="uint64";"group"="default";};
            ];
            "attributes" = {
                "dynamic" = %true;
            };
        };
        "leases" = {
            "schema" = <"strict"=%true;"unique_keys"=%true;>[
                {
                    "name" = "hash";
                    "expression" = "farm_hash(key)";
                    "type" = "uint64";
                    "sort_order" = "ascending";
                    "group" = "default";
                };
                {"name"="key";"type"="string";"sort_order"="ascending";"group"="default";};
                {"name"="subkey";"type"="string";"sort_order"="ascending";"group"="default";};
                {"name"="value";"type"="any";"group"="default";};
            ];
            "attributes" = {
                "dynamic" = %true;
            };
        };
        "leader_election_lock" = {
            "schema" = <"strict"=%true;"unique_keys"=%true;>[
