                {"name"="host";"type"="string";};
                {"name"="data";"type"="string";};
                {"name"="codec";"type"="string";};
                {"name"="$timestamp";"type"="uint64";};
                {"name"="$cumulative_data_weight";"type"="int64";};
            ];
            "attributes" = {
                "dynamic" = %true;
                "tablet_count" = 1;
                "mount_config" = {
                    "min_data_versions" = 0;
                    "min_data_ttl" = 0;
                    "max_data_ttl" = 86400000;
                };
